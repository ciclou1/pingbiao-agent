# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/

# 环境与敏感信息
.env
*.key

# 运行数据
backend/data/
data/
*.log

# 上传的示例标书（含真实下载的招标文件，不入库）
*.pdf
*.docx
*.xlsx
*.zip

# 参考资料：只保留索引 README；第三方克隆仓库不入库
# （它们各自带 .git，会被记成空引用的嵌入仓库，且属他人代码）
参考资料/*/
!参考资料/README.md

# 本地模型（BGE-M3 约 2.3GB，按需从魔搭下载）
models/
