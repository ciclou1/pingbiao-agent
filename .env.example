# 复制为 .env 后按需修改。API key 等敏感信息不进 git。
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
FILES_DIR=/data/files
MAX_UPLOAD_MB=500
WORKER_CONCURRENCY=2
# 生产用独立 worker 容器；本地无 compose 时可置 true 内嵌
EMBEDDED_WORKER=false
# 扫描件 OCR（独立服务：docker compose --profile ocr up -d ocr）
# OCR_WORKERS 控制 OCR 服务进程数（CPU 核多可调大），OCR_CONCURRENCY 为页级并发
OCR_ENABLED=false
OCR_SERVICE_URL=http://ocr:8800
OCR_CONCURRENCY=2
OCR_WORKERS=2

# LLM 网关（M1 起使用）
LLM_BASE_URL=https://www.ai.atyou.cn/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_MODEL_FALLBACK=glm-5.3

# 向量检索（BGE-M3 + pgvector；模型放 models/bge-m3，留空则纯关键词检索）
EMBED_SERVICE_URL=http://embed:8900
EMBED_BATCH=8
